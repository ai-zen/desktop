{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "调试 Electron 主进程",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "${workspaceFolder}/packages/main/node_modules/.bin/electron",
      "runtimeArgs": [
        "--remote-debugging-port=9222",
        "${workspaceFolder}/packages/main/dist/main.mjs"
      ],
      "console": "integratedTerminal",
      "preLaunchTask": "tasks: pre-launch",
      "env": {
        "NODE_ENV": "development"
      },
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/packages/main/dist/**/*.mjs"],
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/packages/main/node_modules/.bin/electron.cmd"
      }
    }
  ]
}
